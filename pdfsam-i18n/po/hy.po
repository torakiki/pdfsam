msgid "No PDF document has been selected"
msgstr "PDF փաստաթուղթ ընտրված չէ"

msgid "Extract"
msgstr "Արտահանել"

msgid "Extract pages from PDF documents."
msgstr "Արտահանել էջեր PDF փաստաթղթերից։"

msgid "File names settings"
msgstr "Ֆայլերի անունների կարգավորումներ"

msgid "Extract settings"
msgstr "Արտահանման կարգավորումներ"

msgid "Output settings"
msgstr "Ելքային կարգավորումներ"

msgid "A separate file for each set of pages"
msgstr "Առանձին ֆայլ էջերի յուրաքանչյուր հավաքածուի համար"

msgid "Each continuous series of pages will generate a separate PDF file"
msgstr "Էջերի յուրաքանչյուր շարունակական հաջորդականություն կստեղծի առանձին PDF ֆայլ"

#~ msgid "Pages to extract (ex: 2 or 5-23 or 2,5-7,12-)"
#~ msgstr "Արտահանվող էջեր (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Invalid page ranges"
msgstr "Էջերի անվավեր միջակայքեր"

msgid "Extract pages:"
msgstr "Արտահանել էջերը՝"

#~ msgid ""
#~ "Comma separated page numbers or ranges to extract (ex: 2 or 5-23 or 2,5-7,12-"
#~ ")"
#~ msgstr "Ստորակետերով բաժանված էջերի համարներ կամ միջակայքեր՝ արտահանելու համար (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Split by bookmarks"
msgstr "Բաժանել ըստ էջանիշների"

msgid ""
"Split a PDF document at bookmarked pages by specifying a bookmark level."
msgstr "Բաժանել PDF փաստաթուղթը էջանշված էջերում՝ նշելով էջանիշի մակարդակը։"

msgid "Regular expression the bookmark has to match"
msgstr "Կանոնավոր արտահայտություն, որին պետք է համապատասխանի էջանիշը"

msgid "Split at this bookmark level:"
msgstr "Բաժանել էջանիշի այս մակարդակում՝"

msgid "Matching regular expression:"
msgstr "Համապատասխանող կանոնավոր արտահայտություն՝"

msgid "A regular expression the bookmark text has to match"
msgstr "Կանոնավոր արտահայտություն, որին պետք է համապատասխանի էջանիշի տեքստը"

msgid ""
"Example: use .*Chapter.* to match bookmarks containing the word \"Chapter\""
msgstr "Օրինակ՝ օգտագործեք .*Chapter.*՝ \"Chapter\" բառը պարունակող էջանիշները գտնելու համար"

msgid "Select or drag and drop the PDF you want to split"
msgstr "Ընտրեք կամ քաշեք ու գցեք այն PDF-ը, որը ցանկանում եք բաժանել"

msgid "Split settings"
msgstr "Բաժանման կարգավորումներ"

msgid "Invalid bookmarks level"
msgstr "Էջանիշների անվավեր մակարդակ"

msgid "Split after"
msgstr "Բաժանել հետո"

msgid "No page selected"
msgstr "Էջ ընտրված չէ"

msgid "Split"
msgstr "Բաժանել"

msgid "Split a PDF document at the given page numbers."
msgstr "Բաժանել PDF փաստաթուղթը տրված էջերի համարներում։"

msgid "Every page"
msgstr "Յուրաքանչյուր էջ"

msgid "Even pages"
msgstr "Զույգ էջեր"

msgid "Odd pages"
msgstr "Կենտ էջեր"

msgid "Split the document after the given page numbers"
msgstr "Բաժանել փաստաթուղթը տրված էջերի համարներից հետո"

msgid "Splits the PDF every \"n\" pages creating documents of \"n\" pages each"
msgstr "Բաժանում է PDF-ը յուրաքանչյուր \"n\" էջից՝ ստեղծելով \"n\" էջից բաղկացած փաստաթղթեր"

msgid "Split after the following page numbers"
msgstr "Բաժանել հետևյալ էջերի համարներից հետո"

msgid "Page numbers to split at (n1,n2,n3..)"
msgstr "Էջերի համարներ, որոնցում բաժանել (n1,n2,n3..)"

msgid "Invalid page numbers"
msgstr "Էջերի անվավեր համարներ"

msgid "Only valid positive page numbers are allowed"
msgstr "Թույլատրվում են միայն վավեր դրական էջերի համարներ"

msgid "Split by every \"n\" pages"
msgstr "Բաժանել յուրաքանչյուր \"n\" էջից"

msgid "Number of pages"
msgstr "Էջերի քանակ"

msgid "Invalid number of pages"
msgstr "Էջերի անվավեր քանակ"

msgid "Megabytes"
msgstr "Մեգաբայթ"

msgid "MB"
msgstr "ՄԲ"

msgid "Kilobytes"
msgstr "Կիլոբայթ"

msgid "KB"
msgstr "ԿԲ"

msgid "Split by size"
msgstr "Բաժանել ըստ չափի"

msgid "Split a PDF document in files of the given size (roughly)."
msgstr "Բաժանել PDF փաստաթուղթը տրված չափի (մոտավորապես) ֆայլերի։"

msgid "Set the size to split at"
msgstr "Սահմանել բաժանման չափը"

msgid "Size must be a number"
msgstr "Չափը պետք է լինի թիվ"

#~ msgid "Split at this size:"
#~ msgstr "Բաժանել այս չափով՝"

msgid "Invalid split size"
msgstr "Բաժանման անվավեր չափ"

msgid "Destination file"
msgstr "Նպատակակետ ֆայլ"

msgid "Alternate Mix"
msgstr "Հերթափոխ խառնում"

msgid ""
"Merge two or more PDF documents taking pages alternately in natural or "
"reverse order."
msgstr "Միավորել երկու կամ ավելի PDF փաստաթղթեր՝ էջերը վերցնելով հերթափոխով բնական կամ հակառակ կարգով։"

msgid "Double click to set pages you want to mix (ex: 2 or 5-23 or 2,5-7,12-)"
msgstr "Կրկնակի սեղմեք՝ խառնելու ենթակա էջերը սահմանելու համար (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Select a positive integer number as pace"
msgstr "Ընտրեք դրական ամբողջ թիվ որպես քայլ"

msgid "All pages"
msgstr "Բոլոր էջերը"

msgid "90 degrees clockwise"
msgstr "90 աստիճան ժամսլաքի ուղղությամբ"

msgid "180 degrees clockwise"
msgstr "180 աստիճան ժամսլաքի ուղղությամբ"

msgid "90 degrees counterclockwise"
msgstr "90 աստիճան ժամսլաքին հակառակ"

#~ msgid "Rotate "
#~ msgstr "Պտտել"

msgid "Rotate settings"
msgstr "Պտտման կարգավորումներ"

msgid "Rotate"
msgstr "Պտտել"

msgid "Rotate the pages of multiple PDF documents."
msgstr "Պտտել բազմաթիվ PDF փաստաթղթերի էջերը։"

#~ msgid ""
#~ "Double click to set pages you want to rotate (ex: 2 or 5-23 or 2,5-7,12-)"
#~ msgstr "Կրկնակի սեղմեք՝ պտտելու ենթակա էջերը սահմանելու համար (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Merge settings"
msgstr "Միավորման կարգավորումներ"

msgid ""
"Double click to set pages you want to merge (ex: 2 or 5-23 or 2,5-7,12-)"
msgstr "Կրկնակի սեղմեք՝ միավորելու ենթակա էջերը սահմանելու համար (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Add a blank page if page number is odd"
msgstr "Ավելացնել դատարկ էջ, եթե էջի համարը կենտ է"

msgid ""
"Adds a blank page after each merged document if the document has an odd "
"number of pages"
msgstr "Յուրաքանչյուր միավորված փաստաթղթից հետո ավելացնում է դատարկ էջ, եթե փաստաթուղթն ունի կենտ թվով էջեր"

msgid "Add a footer"
msgstr "Ավելացնել ստորագիր"

msgid "Adds a page footer with the name of the file the page belonged to."
msgstr "Ավելացնում է էջի ստորագիր՝ նշելով այն ֆայլի անունը, որին պատկանում էր էջը։"

msgid "None"
msgstr "Չկա"

msgid "Same width as first page"
msgstr "Նույն լայնությունը, ինչ առաջին էջը"

msgid "Same width as first page (based on page orientation)"
msgstr "Նույն լայնությունը, ինչ առաջին էջը (հիմնված էջի կողմնորոշման վրա)"

#~ msgid "Pages normalization:"
#~ msgstr "Էջերի նորմալացում՝"

msgid ""
"Set whether pages should be resized to all have the same width as the first "
"one"
msgstr "Սահմանել՝ արդյոք էջերը պետք է չափափոխվեն, որպեսզի բոլորն ունենան առաջինի նույն լայնությունը"

msgid "Merge fields"
msgstr "Միավորել դաշտերը"

msgid "Merge renaming existing fields"
msgstr "Միավորել՝ վերանվանելով գոյություն ունեցող դաշտերը"

msgid "Flatten"
msgstr "Հարթեցնել"

msgid "Discard forms"
msgstr "Հեռացնել ձևերը"

#~ msgid "Interactive forms (AcroForms):"
#~ msgstr "Ինտերակտիվ ձևեր (AcroForms)՝"

msgid "What to do in case one or more input documents contain Acro Forms"
msgstr "Ինչ անել, եթե մեկ կամ ավելի մուտքային փաստաթղթեր պարունակում են Acro Forms"

msgid "Retain bookmarks"
msgstr "Պահպանել էջանիշները"

msgid "Discard bookmarks"
msgstr "Հեռացնել էջանիշները"

msgid "Create one entry for each merged document"
msgstr "Ստեղծել մեկ գրառում յուրաքանչյուր միավորված փաստաթղթի համար"

msgid "Retain bookmarks as one entry for each merged document"
msgstr "Պահպանել էջանիշները որպես մեկ գրառում յուրաքանչյուր միավորված փաստաթղթի համար"

#~ msgid "Bookmarks handling:"
#~ msgstr "Էջանիշների մշակում՝"

msgid "What to do in case one or more input documents contain bookmarks"
msgstr "Ինչ անել, եթե մեկ կամ ավելի մուտքային փաստաթղթեր պարունակում են էջանիշներ"

msgid "Don't generate"
msgstr "Չստեղծել"

msgid "Generate from file names"
msgstr "Ստեղծել ֆայլերի անուններից"

msgid "Generate from documents titles"
msgstr "Ստեղծել փաստաթղթերի վերնագրերից"

#~ msgid "Table of contents:"
#~ msgstr "Բովանդակության աղյուսակ՝"

msgid ""
"Set if a table of contents should be added to the generated PDF document"
msgstr "Սահմանել՝ արդյոք բովանդակության աղյուսակ պետք է ավելացվի ստեղծվող PDF փաստաթղթին"

msgid "Merge"
msgstr "Միավորել"

#~ msgid "Merge together multiple PDF documents or subsections of them."
#~ msgstr "Միավորել միասին բազմաթիվ PDF փաստաթղթեր կամ դրանց ենթաբաժինները։"

msgid "Select or drag and drop the PDF whose pages will be repeated"
msgstr "Ընտրեք կամ քաշեք ու գցեք այն PDF-ը, որի էջերը կկրկնվեն"

msgid "Repeat these pages:"
msgstr "Կրկնել այս էջերը՝"

msgid "Pages to repeat (ex: 2 or 5-23 or 2,5-7,12-)"
msgstr "Կրկնվող էջեր (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid ""
"Comma separated page numbers or ranges to be repeated (ex: 2 or 5-23 or 2,5-"
"7,12-)"
msgstr "Ստորակետերով բաժանված էջերի համարներ կամ միջակայքեր, որոնք պետք է կրկնվեն (օր․՝ 2 կամ 5-23 կամ 2,5-7,12-)"

msgid "Leave it empty to use all the pages of the PDF file"
msgstr "Թողեք դատարկ՝ PDF ֆայլի բոլոր էջերն օգտագործելու համար"

msgid "Repeat every \"n\" pages:"
msgstr "Կրկնել յուրաքանչյուր \"n\" էջից՝"

msgid "Invalid page number"
msgstr "Էջի անվավեր համար"

msgid "Repeat the selected pages every \"n\" pages of the original document"
msgstr "Կրկնել ընտրված էջերը բնօրինակ փաստաթղթի յուրաքանչյուր \"n\" էջից"

msgid "The selected PDF file is invalid"
msgstr "Ընտրված PDF ֆայլը անվավեր է"

msgid "The number of pages must be a positive number"
msgstr "Էջերի քանակը պետք է լինի դրական թիվ"

msgid "Select or drag and drop the PDF you want to insert pages to"
msgstr "Ընտրեք կամ քաշեք ու գցեք այն PDF-ը, որին ցանկանում եք էջեր տեղադրել"

msgid "Insert and Repeat settings"
msgstr "Տեղադրման և կրկնման կարգավորումներ"

msgid "Insert pages multiple times"
msgstr "Տեղադրել էջերը մի քանի անգամ"

msgid ""
"Insert the pages of a PDF document A into another document B, repeating it "
"after a certain number of pages, resulting in B1 A B2 A B3 A etc."
msgstr "Տեղադրել PDF փաստաթուղթ A-ի էջերը մեկ այլ՝ B փաստաթղթի մեջ՝ կրկնելով դրանք որոշակի քանակի էջերից հետո, ինչի արդյունքում ստացվում է B1 A B2 A B3 A և այլն։"

#, java-format
msgid "Started in {0}"
msgstr "Սկսվել է {0}-ում"

msgid "Closing PDFsam..."
msgstr "Փակվում է PDFsam-ը..."

msgid "Drag and drop PDF files or directories containing PDF files"
msgstr "Քաշեք և գցեք PDF ֆայլեր կամ PDF ֆայլեր պարունակող պանակներ"

msgid "No PDF found"
msgstr "PDF չի գտնվել"

msgid "Tools"
msgstr "Գործիքներ"

msgid "News"
msgstr "Նորություններ"

msgid "What's new"
msgstr "Ինչ նոր է"

msgid "Exit"
msgstr "Ելք"

msgid "Exit the application"
msgstr "Դուրս գալ հավելվածից"

msgid "Workspace"
msgstr "Աշխատանքային տարածք"

msgid "Manage your workspaces"
msgstr "Կառավարեք ձեր աշխատանքային տարածքները"

msgid "Yes"
msgstr "Այո"

msgid "No"
msgstr "Ոչ"

msgid "Confirm clearing"
msgstr "Հաստատել մաքրումը"

msgid "Do you confirm?"
msgstr "Հաստատո՞ւմ եք"

msgid "Clear the tool settings"
msgstr "Մաքրել գործիքի կարգավորումները"

msgid "Clear the selection table"
